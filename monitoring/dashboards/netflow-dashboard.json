          "query": "from(bucket: \"netflow\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"netflow\" and r._field == \"in_bytes\" and r.dst_port == \"53\" and r.dst != \"192.168.193.1\")\n  |> group(columns: [\"src\", \"dst\"])\n  |> sum(column: \"_value\")\n  |> sort(columns: [\"_value\"], desc: true)\n  |> rename(columns: {src: \"Source\", dst: \"DNS Server\", _value: \"Bytes\"})",
          "refId": "A"
        }
      ]
    }
  ]
}